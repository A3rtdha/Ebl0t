# Discord Bot Token (никому не показывать!)
DISCORD_TOKEN=your_bot_token_here

# Прокси для Discord API (http/https/socks5). Опционально.
# PROXY=http://127.0.0.1:2080

# Henrik Dev API — для получения ranked-ранга по Riot ID
# Получить бесплатно: https://docs.henrikdev.xyz/
# Без ключа бот работает, но ранг при автопривязке не будет подтягиваться
HENRIK_API_KEY=

# ── Распознавание скриншотов ──────────────────────────────────────────
# ОСНОВНОЙ способ: Gemini Vision (бесплатно, точность ~как у человека).
# Ключ бесплатно: https://aistudio.google.com/apikey
# Без ключа бот автоматически использует локальный Tesseract OCR.
GEMINI_API_KEY=
# Модель (gemini-2.5-flash — free tier; 2.0-flash часто даёт 429 limit:0)
GEMINI_MODEL=gemini-2.5-flash
# Gemini геоблокирован в РФ. Если ты в РФ — укажи прокси/VPN (http/https/socks5).
# Если не задано — берётся общий PROXY. Пример: GEMINI_PROXY=http://127.0.0.1:2080
# GEMINI_PROXY=

# ЗАПАСНОЙ способ: локальный Tesseract OCR
# Windows: если Tesseract не в PATH, укажи полный путь к tesseract.exe
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
