# ─── Секреты (никогда не коммитить) ─────────────────────────────
# Discord токен, Henrik API ключ, прокси — всё в .env
.env
.env.*
!.env.example

# Proxy / VPN (VLESS UUID, sing-box конфиги)
proxy/

# Runtime data (кроме статического game_data.json)
data/*.json
!data/game_data.json
data.json

# Локальные скриншоты для OCR-тестов (содержат ники игроков)
*.png
!docs/**/*.png

# ─── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
*.egg
.eggs/
dist/
build/
*.manifest

# ─── IDE & editors ──────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── OS junk ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Logs & temp ────────────────────────────────────────────────
.eblot.pid
*.log
*.tmp
*.temp
.cache/

