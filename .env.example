# Discord Bot Token (никому не показывать!)
DISCORD_TOKEN=your_bot_token_here

# Имя роли для пинга при /custom (без @)
VALORANT_ROLE_NAME=valorant

# Henrik Dev API — для получения ranked-ранга по Riot ID
# Получить бесплатно: https://docs.henrikdev.xyz/
# Без ключа бот работает, но ранг при автопривязке не будет подтягиваться
HENRIK_API_KEY=

# Парсинг скриншотов — локально через Tesseract OCR
# Windows: если Tesseract не в PATH, укажи полный путь к tesseract.exe
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
